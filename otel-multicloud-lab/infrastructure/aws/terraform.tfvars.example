# false crea solo ECR. Cámbialo a true después de publicar la imagen.
create_instance     = false
aws_region          = "us-east-1"
instance_type       = "t3.small"
service_b_port      = 8082
service_b_image_tag = "lab"
postgres_user       = "postgres"
postgres_db         = "orders_db"
grafana_otlp_endpoint     = "https://otlp-gateway.example.invalid/otlp"
grafana_otlp_auth         = "Basic REPLACE_WITH_BASE64"

